FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    qt6-base-dev \
    qt6-tools-dev \
    mingw-w64 \
    wine \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Build for Windows
RUN mkdir build && cd build && \
    x86_64-w64-mingw32-cmake .. && \
    make -j$(nproc)

# Copy built files
RUN cp build/psio-assist.exe /output/
